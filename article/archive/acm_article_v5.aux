\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Relationship categories associated with an immutable \textit  {ACI Revision}. ACM organizes relationships into four complementary families aligned with the governance views of the reference model. Configuration relationships describe the structural organization of governed configuration items, Evolution relationships capture revision history and baseline evolution, Runtime relationships associate immutable revisions with execution observations, and Assurance relationships link configuration revisions to governance evidence, compliance results, and policy enforcement. This categorization separates orthogonal governance concerns while preserving explicit traceability through a common immutable revision.}}{13}{figure.caption.16}\protected@file@percent }
\newlabel{fig:relationship_model}{{5}{13}{Relationship categories associated with an immutable \textit {ACI Revision}. ACM organizes relationships into four complementary families aligned with the governance views of the reference model. Configuration relationships describe the structural organization of governed configuration items, Evolution relationships capture revision history and baseline evolution, Runtime relationships associate immutable revisions with execution observations, and Assurance relationships link configuration revisions to governance evidence, compliance results, and policy enforcement. This categorization separates orthogonal governance concerns while preserving explicit traceability through a common immutable revision}{figure.caption.16}{}}
\newlabel{fig:relationship_model@cref}{{[figure][5][]5}{[1][11][]13}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Conceptual organization of an ACM release baseline. A release baseline defines an immutable and versioned snapshot of the governed configuration by grouping a consistent set of ACI revisions. Baseline membership explicitly identifies the configuration revisions composing the release, while cross-ACI relationships preserve the structural dependencies among configuration items (e.g., agents, workflows, prompts, tools, models, and policies). This separation allows a baseline to provide a reproducible configuration snapshot while maintaining the dependency information required for impact analysis, traceability, and governance throughout the system lifecycle.}}{14}{figure.caption.17}\protected@file@percent }
\newlabel{fig:release_baseline}{{6}{14}{Conceptual organization of an ACM release baseline. A release baseline defines an immutable and versioned snapshot of the governed configuration by grouping a consistent set of ACI revisions. Baseline membership explicitly identifies the configuration revisions composing the release, while cross-ACI relationships preserve the structural dependencies among configuration items (e.g., agents, workflows, prompts, tools, models, and policies). This separation allows a baseline to provide a reproducible configuration snapshot while maintaining the dependency information required for impact analysis, traceability, and governance throughout the system lifecycle}{figure.caption.17}{}}
\newlabel{fig:release_baseline@cref}{{[figure][6][]6}{[1][12][]14}}
\newlabel{eq:acm_descriptor}{{1}{14}{Governance Semantics}{equation.5.1}{}}
\newlabel{eq:acm_descriptor@cref}{{[equation][1][]1}{[1][14][]14}}
