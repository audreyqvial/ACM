\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Orthogonal governance state machines composing the ACM governance semantics. Lifecycle, quality, impact, and assurance are evaluated as distinct state dimensions, while execution eligibility is derived through the evaluation function $f(L,Q,A,I)$.}}{5}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:governance_state_machine}{{1}{5}{Orthogonal governance state machines composing the ACM governance semantics. Lifecycle, quality, impact, and assurance are evaluated as distinct state dimensions, while execution eligibility is derived through the evaluation function $f(L,Q,A,I)$}{figure.caption.1}{}}
\newlabel{fig:governance_state_machine@cref}{{[figure][1][]1}{[1][4][]5}}
